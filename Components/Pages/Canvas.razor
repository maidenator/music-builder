@page "/canvas"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Canvas</PageTitle>

<div class="canvas-page">
    <svg @ref="_svg"
         class="dot-canvas"
         role="img"
         aria-label="Infinite polka dot canvas. Drag to pan.">
        <defs>
            <pattern id="dot-pattern"
                     patternUnits="userSpaceOnUse"
                     width="@Spacing"
                     height="@Spacing"
                     patternTransform="translate(0 0)">
                <circle cx="@(Spacing / 2.0)" cy="@(Spacing / 2.0)" r="@DotRadius" fill="@DotColor" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#dot-pattern)" />
    </svg>

    <p class="canvas-hint" aria-hidden="true">Drag to pan</p>
</div>

@code {
    // Tweak these to change the look.
    private const double Spacing = 24;   // distance between dots (px)
    private const double DotRadius = 1.2; // dot size (px)
    private const string DotColor = "#c9cbd1";

    private ElementReference _svg;
    private IJSObjectReference? _module;
    private IJSObjectReference? _pan;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dot-canvas.js");
        _pan = await _module.InvokeAsync<IJSObjectReference>("initPan", _svg);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_pan is not null)
            {
                await _pan.InvokeVoidAsync("destroy");
                await _pan.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit is already gone; nothing to clean up on the client.
        }
    }
}
